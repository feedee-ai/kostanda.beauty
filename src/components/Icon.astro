---
interface Props { name: 'whatsapp' | 'instagram' | 'phone' | 'pin' | 'clock' | 'arrow' | 'arrowUpRight' | 'plus' | 'star' | 'video'; size?: number; class?: string }
const { name, size = 20, class: cls = '' } = Astro.props;
---
<svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'whatsapp' && (
    <>
      <path d="M3.6 20.4l1.2-4.1A8.4 8.4 0 1 1 8 19.3l-4.4 1.1z" />
      <path d="M9 8.3c.2-.5.5-.6.8-.6h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.3.6.8 1.2 1.3 1.6.5.4 1 .7 1.6.9.2.1.4 0 .5-.1l.6-.7c.1-.2.4-.2.6-.1l1.5.7c.2.1.3.3.3.5 0 .5-.2 1.1-.6 1.4-.5.4-1.2.6-1.9.4-1.3-.3-2.5-1-3.5-1.9-1-.9-1.8-2-2.2-3.2-.2-.7-.1-1.6.4-2.2z" stroke-width="1.1" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="3.8" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'phone' && <path d="M6.6 3.8h2.3l1.4 4-1.8 1.2a11 11 0 0 0 6.5 6.5l1.2-1.8 4 1.4v2.3c0 1.1-.9 2-2 2A16 16 0 0 1 4.6 5.8c0-1.1.9-2 2-2z" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrowUpRight' && <path d="M7 17L17 7M9 7h8v8" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'star' && <path d="M12 3.8l2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8z" fill="currentColor" stroke="none" />}
  {name === 'video' && (
    <>
      <rect x="3" y="6" width="13" height="12" rx="2.5" />
      <path d="M16 10.5l5-3v9l-5-3" />
    </>
  )}
</svg>
