---
interface Props { class?: string; withWord?: boolean; tone?: 'ink' | 'light' }
const { class: cls = '', withWord = true, tone = 'ink' } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`, cls]}>
  <svg class="logo__mark" viewBox="100 120 730 480" aria-hidden="true">
    <g>
      <path d="M222 125A290 290 0 0 0 222 595A290 290 0 0 0 222 125Z" />
      <path d="M382 125A290 290 0 0 0 382 595A290 290 0 0 0 382 125Z" />
      <path d="M825 125A250 250 0 0 0 553 400A250 250 0 0 0 825 125Z" />
      <path d="M553 318A250 250 0 0 0 825 595A250 250 0 0 0 553 318Z" />
    </g>
  </svg>
  {withWord && (
    <span class="logo__word">
      <span class="logo__name">Kostanda Beauty</span>
      <span class="logo__sub">Cosmetología</span>
    </span>
  )}
</span>
