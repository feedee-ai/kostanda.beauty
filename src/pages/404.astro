---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base lang="es">
  <main class="nf">
    <a href="/" aria-label="Kostanda Beauty"><Logo /></a>
    <h1>Página no encontrada</h1>
    <p>Страница не найдена</p>
    <a class="btn" href="/"><span>Volver al inicio</span><span class="btn__icon" aria-hidden="true">→</span></a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 20px;
    padding: 24px;
    text-align: center;
  }
  .nf a:first-child {
    text-decoration: none;
    margin-bottom: 24px;
  }
  .nf h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  .nf p {
    color: var(--ink-2);
    margin-bottom: 12px;
  }
</style>
